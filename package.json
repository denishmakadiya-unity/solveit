{
  "name": "solveit",
  "version": "1.0.0",
  "private": true,
  "description": "SolveIt — Your Problem. Our Tools. A problem-first utility workspace.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "preview": "node scripts/dev-server.mjs",
    "deploy": "node scripts/build.mjs && wrangler pages deploy dist --project-name solveit",
    "db:init": "wrangler d1 execute solveit --remote --file=schema.sql"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=20" }
}
